# Copy to `.env` and fill in. Only DATABASE_URL, the JWT secrets and
# TMDB_API_KEY are needed to run Kaset locally — everything else is optional
# and availability-gated.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/kaset
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
TMDB_API_KEY=

# ── Defaults are usually fine ───────────────────────────────────────────────
TMDB_BASE_URL=https://api.themoviedb.org/3
# Comma-separated; becomes the CORS allowlist.
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Discovery engine (optional) ─────────────────────────────────────────────
# Without these, discovery serves whatever is already cached rather than failing.
# The LLM extracts candidates from evidence and ranks the resolved pool; it
# never invents films.
LLM_API_KEY=
LLM_MODEL=gpt-5.5
# Set to point the OpenAI-compatible client at a different provider.
LLM_BASE_URL=

# Reddit — primary evidence source. Offline/warmer only, never the request path.
# Create a "script" app at reddit.com/prefs/apps for the id + secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kaset/1.0 (offline discovery evidence collection)

# Brave Search — secondary evidence source. Free key (1 req/s) at
# api.search.brave.com. Warmer only.
BRAVE_SEARCH_API_KEY=

# ── Cache (optional) ────────────────────────────────────────────────────────
# DB index 1 keeps Kaset isolated from other projects on this Redis server.
REDIS_URL=redis://localhost:6379/1
